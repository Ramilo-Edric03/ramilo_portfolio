---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ProjectGallery from "../../components/ProjectGallery.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevProject =
      index > 0 ? projects[index - 1] : projects[projects.length - 1];
    const nextProject =
      index < projects.length - 1 ? projects[index + 1] : projects[0];
    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    };
  });
}

interface Props {
  project: Project;
  prevProject: Project;
  nextProject: Project;
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout
  title={`${project.title} | Edric Russell Ramilo`}
  description={`${project.title} case study, architecture pipeline, and tech stack.`}
>
  <Header currentPath={`/projects/${project.slug}`} />

  <main
    class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12"
  >
    <div>
      <a
        href="/projects"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-400 hover:text-white transition-colors"
      >
        <span>←</span>
        <span>Back to projects</span>
      </a>
    </div>

    <section aria-label="Project Gallery">
      <ProjectGallery images={project.images} projectTitle={project.title} />
    </section>

    <header class="space-y-4 border-b border-white/10 pb-8">
      <h1
        class="font-display font-bold text-3xl sm:text-4xl text-white tracking-tight"
      >
        {project.title}
      </h1>

      <p class="text-sm sm:text-base text-zinc-300 font-sans leading-relaxed">
        {project.summary}
      </p>

      <div class="pt-2">
        <a
          href={project.primaryAction.href}
          target={project.primaryAction.external ? "_blank" : undefined}
          rel={project.primaryAction.external
            ? "noopener noreferrer"
            : undefined}
          class="inline-flex items-center gap-2 font-display text-xs font-semibold uppercase tracking-wider h-8 px-4 bg-white text-black hover:bg-zinc-200 transition-colors"
        >
          <span>{project.primaryAction.label}</span>
          <span class="font-mono text-xs"
            >{project.primaryAction.external ? "↗" : "→"}</span
          >
        </a>
      </div>
    </header>

    <section class="space-y-4" aria-label="Architecture Pipeline">
      <h2 class="font-display font-bold text-xl text-white tracking-tight">
        Architecture pipeline
      </h2>

      <div class="border border-white/10 divide-y divide-white/10">
        {
          project.pipeline.map((step, idx) => (
            <div class="p-4 flex items-start gap-4">
              <span class="font-mono text-xs text-zinc-500 pt-0.5 shrink-0">
                0{idx + 1}
              </span>
              <div class="space-y-1 min-w-0">
                <h3 class="font-display font-bold text-sm text-white">
                  {step.name}
                </h3>
                <p class="text-xs text-zinc-400 font-sans leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="space-y-4" aria-label="Problem and Solution">
      <h2 class="font-display font-bold text-xl text-white tracking-tight">
        Case study
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="border border-white/10 p-5 space-y-2">
          <span
            class="font-mono text-xs text-zinc-400 uppercase tracking-wider block"
          >
            The problem
          </span>
          <p class="text-xs sm:text-sm text-zinc-300 font-sans leading-relaxed">
            {project.problem}
          </p>
        </div>

        <div class="border border-white/10 p-5 space-y-2">
          <span
            class="font-mono text-xs text-zinc-400 uppercase tracking-wider block"
          >
            The solution
          </span>
          <p class="text-xs sm:text-sm text-zinc-300 font-sans leading-relaxed">
            {project.solution}
          </p>
        </div>
      </div>
    </section>

    <section class="space-y-4" aria-label="Stack Used">
      <h2 class="font-display font-bold text-xl text-white tracking-tight">
        Stack used
      </h2>

      <div class="flex flex-wrap gap-2">
        {
          project.stack.map((item) => (
            <span class="px-2.5 py-1 border border-white/10 bg-zinc-950 font-mono text-xs text-zinc-300">
              {item}
            </span>
          ))
        }
      </div>
    </section>

    <footer
      class="pt-8 border-t border-white/10 flex items-center justify-between font-mono text-xs text-zinc-400"
    >
      <a
        href={`/projects/${prevProject.slug}`}
        class="hover:text-white transition-colors"
      >
        ← {prevProject.title}
      </a>
      <a
        href={`/projects/${nextProject.slug}`}
        class="hover:text-white transition-colors"
      >
        {nextProject.title} →
      </a>
    </footer>
  </main>
</Layout>
