---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import DitherVeil from "../components/ui/react-bits/DitherVeil";
import TechText from "../components/ui/react-bits/TechText";
import BorderGlow from "../components/ui/react-bits/BorderGlow";
import ASCIIText from "../components/ui/react-bits/ASCIIText";
import AwsLogo from "../components/icons/AwsLogo.astro";
import PearsonLogo from "../components/icons/PearsonLogo.astro";
import { ArchGallery } from "../components/ui/first-dev/arch-gallery";

// Experience Milestones
const experienceMilestones = [
  {
    period: "May 2026 to present",
    role: "Studying & Job Hunting",
    organization: "Remote",
    status: "Current",
    logo: null,
    logoAlt: null,
    highlights: ["Reviewing logic, system design, and web development."],
  },
  {
    period: "January 2026 to May 2026",
    role: "Software engineering intern",
    organization: "Snapp Ventures Inc.",
    status: "Completed",
    logo: "/Snapp_ventures-svg.svg",
    logoAlt: "Snapp Ventures Inc. logo",
    highlights: [
      "Tested releases across frontend and backend services to verify data flow before deployment.",
      "Wrote and executed more than 60 manual test cases, then used Playwright to automate end-to-end regression tests.",
      "Created 7 database collections and 8 automated flows in Directus CMS to review and approve leave requests.",
      "Built OpenKitchen, an internal tool that translates plain text prompts into Playwright browser workflows.",
    ],
  },
  {
    period: "September 2024 to July 2025",
    role: "Student assistant",
    organization: "FAITH Colleges",
    status: "Completed",
    logo: "/faith_colleges-logo.png",
    logoAlt: "FAITH Colleges logo",
    highlights: [
      "Coordinated academic operations between department faculty and the admissions office.",
      "Digitized departmental student records so staff could locate files faster.",
      "Assisted student services during campus events with equipment setup and student coordination.",
    ],
  },
];

// Featured Projects (Minimal for Home Page)
const flagshipProjects = [
  {
    id: "01",
    title: "AWS Web App Architecture Design",
    summary:
      "Production-ready AWS infrastructure specification designed for high availability and fault tolerance. Distributes compute traffic across two availability zones using public load balancers, auto-scaling private EC2 fleets, and isolated RDS database subnets.",
    href: "/projects/aws-web-architecture",
  },
  {
    id: "02",
    title: "Share-Your-Secret",
    summary:
      "Zero-knowledge secret-sharing web application built on AWS serverless primitives. Encrypts sensitive credentials in the browser using the Web Crypto API with AES-256-GCM before transport, storing ciphertext in DynamoDB with single-read destruction and automated 24-hour TTL expiration.",
    href: "/projects/share-your-secret",
  },
  {
    id: "03",
    title: "OpenKitchen",
    summary:
      "Internal operations platform developed at Snapp Ventures to replace repetitive manual web scraping workflows. Translates plain English instructions into structured JSON execution steps via the Gemini API, drives browser automation in Playwright, and exports formatted tables to Excel via ExcelJS.",
    href: "/projects/openkitchen",
  },
];

// Verified Certifications
const certifications = [
  {
    id: "aws",
    title: "AWS Certified Cloud Practitioner",
    issuer: "Amazon Web Services",
    year: "2025",
    badgeUrl:
      "https://www.credly.com/badges/de4b2160-0dd5-4ef0-9c2d-f880cbbc813e/public_url",
    badgeId: "de4b2160-0dd5-4ef0-9c2d-f880cbbc813e",
    pillars: [
      "Cloud concepts and security models",
      "Core AWS services including IAM, EC2, S3, and RDS",
      "Billing, pricing, and account management",
    ],
  },
  {
    id: "pearson",
    title: "Certiport IT Specialist: Cloud Computing",
    issuer: "Certiport, Pearson VUE",
    year: "2026",
    badgeUrl:
      "https://www.credly.com/badges/a312ea48-a993-456f-ab6e-f42f686c6961/public_url",
    badgeId: "a312ea48-a993-456f-ab6e-f42f686c6961",
    pillars: [
      "Cloud architecture and delivery models",
      "Storage, compute, and networking fundamentals",
      "Cloud security and compliance",
    ],
  },
];

// Technical Skill Matrix
const skillDomains = [
  {
    domain: "Cloud",
    skills: ["AWS IAM, EC2, S3, Lambda", "VPC, DynamoDB, RDS", "Amplify"],
  },
  {
    domain: "Programming languages",
    skills: ["TypeScript", "JavaScript", "Python", "SQL", "HTML and CSS"],
  },
  {
    domain: "Frontend and Backend",
    skills: [
      "Next.js",
      "React",
      "Node.js and Express",
      "Supabase PostgreSQL",
      "MySQL",
    ],
  },
  {
    domain: "QA, automation, and tools",
    skills: ["Playwright", "Google Gemini API", "Git and GitHub", "Linux"],
  },
];

const currentYear = new Date().getFullYear();
---

<Layout
  title="Edric Russell Ramilo | Cloud and Software Engineer"
  description="Portfolio of Edric Russell Ramilo, software engineer with projects in AWS architecture, serverless apps, and browser automation."
>
  <Header currentPath="/" />

  <main class="w-full bg-black selection:bg-white selection:text-black">
    <section
      id="top"
      class="min-h-[calc(100dvh-3rem)] lg:min-h-screen w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-8 sm:py-12 scroll-mt-5 lg:scroll-mt-0 relative snap-start"
      aria-label="Introduction"
    >
      <div
        class="max-w-4xl w-full flex flex-col items-center text-center space-y-6 sm:space-y-8 my-auto"
      >
        <h1 class="sr-only">Edric Russell Ramilo</h1>
        <div
          class="w-full h-16 sm:h-24 md:h-28 flex items-center justify-center"
        >
          <TechText
            client:load
            text="Edric Russell Ramilo"
            fontFamily="Space Grotesk, sans-serif"
            fontWeight={700}
            fontSize={140}
            color="#f4f4f5"
            accentColor="#ffffff"
            reach={180}
            lineStyle="dashed"
            reveal="letter"
            specks={15}
            selection={true}
            labels={true}
            draggable={true}
            sweep={true}
            speed={1}
            className="w-full h-full z-[40]"
            style={{}}
          />
        </div>

        <div class="flex justify-center">
          <div
            style={{
              width: "220px",
              height: "220px",
              maxWidth: "100%",
              position: "relative",
            }}
            class="border border-white/15 bg-zinc-950 shadow-2xl"
          >
            <DitherVeil
              client:load
              src="/Avatar.jpg"
              fit="cover"
              pattern="lines"
              pixelSize={2}
              inkColor="#120f17"
              paperColor="#f4f1ea"
              revealRadius={80}
              softness={0.5}
              linger={1}
              contrast={1.1}
            />
          </div>
        </div>

        <div class="space-y-2 max-w-xl mx-auto">
          <p
            class="text-sm sm:text-base text-zinc-300 font-sans leading-relaxed"
          >
            I'm a Software Engineer. I build web applications, serverless
            backends, and practical AWS cloud infrastructure. Currently
            upskilling in system design, cloud architecture, and full-stack
            engineering.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-3 pt-1">
          <a
            href="#contact"
            class="inline-flex items-center justify-center font-display text-xs font-semibold uppercase tracking-wider h-9 px-5 bg-white text-black hover:bg-zinc-200 transition-all border border-transparent rounded-none focus-visible:outline-ring"
          >
            Get in touch
          </a>
          <a
            href="#projects"
            class="inline-flex items-center justify-center font-display text-xs font-semibold uppercase tracking-wider h-9 px-5 bg-transparent text-white hover:bg-white/10 transition-all border border-white/20 rounded-none focus-visible:outline-ring"
          >
            View projects
          </a>
        </div>
      </div>

      <div
        class="scroll-anchor hidden sm:flex justify-center pt-4 sm:pt-6 transition-opacity duration-300 opacity-0 pointer-events-none"
      >
        <a
          href="#experience"
          class="group inline-block select-none"
          aria-label="Scroll to Experience"
        >
          <BorderGlow
            client:visible
            edgeSensitivity={0}
            minProximityOnHover={0.75}
            borderRadius={0}
            glowRadius={10}
            glowIntensity={0.8}
            coneSpread={25}
            animated
            colors={["#FFFFFF", "#FFFFFF", "#FFFFFF"]}
            glowColor="0 0 100"
            backgroundColor="#000000"
            fillOpacity={0.15}
            className="w-fit inline-flex items-center px-3 py-1 cursor-pointer"
            timeout={3000}
          >
            <span
              class="font-mono text-[10px] text-zinc-400 group-hover:text-white transition-colors uppercase tracking-widest flex items-center gap-1.5"
            >
              <span>Experience ↓</span>
            </span>
          </BorderGlow>
        </a>
      </div>
    </section>

    <section
      id="experience"
      class="min-h-[100dvh] w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-12 sm:py-16 scroll-mt-5 lg:scroll-mt-0 relative snap-start"
      aria-label="Experience"
    >
      <div class="max-w-2xl w-full mx-auto my-auto space-y-6 sm:space-y-8">
        <div class="text-center space-y-2">
          <h2
            class="font-display font-bold text-2xl sm:text-3xl text-white tracking-tight"
          >
            Experience.
          </h2>
        </div>

        <div class="space-y-4">
          {
            experienceMilestones.map((milestone) => (
              <div class="group border border-white/10 bg-zinc-950/80 p-5 space-y-4 hover:border-white/25 transition-colors rounded-none text-left">
                <div class="flex items-start gap-3.5 sm:gap-4 border-b border-white/10 pb-3.5">
                  <div class="w-11 h-11 sm:w-12 sm:h-12 shrink-0 bg-zinc-900/90 border border-white/10 group-hover:border-white/25 flex items-center justify-center p-2 transition-colors rounded-none">
                    {milestone.logo ? (
                      <img
                        src={milestone.logo}
                        alt={
                          milestone.logoAlt || `${milestone.organization} logo`
                        }
                        class="w-full h-full object-contain opacity-75 group-hover:opacity-100 transition-opacity"
                        loading="lazy"
                      />
                    ) : (
                      <svg
                        class="w-5 h-5 sm:w-6 sm:h-6 text-zinc-400 group-hover:text-white transition-colors"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="4 17 10 11 4 5" />
                        <line x1="12" y1="19" x2="20" y2="19" />
                      </svg>
                    )}
                  </div>

                  <div class="flex-1 min-w-0 flex flex-col sm:flex-row sm:items-start justify-between gap-1.5 sm:gap-4">
                    <div>
                      <h3 class="font-display font-bold text-base sm:text-lg text-white leading-snug">
                        {milestone.role}
                      </h3>
                      <div class="text-xs text-zinc-400 font-sans mt-0.5">
                        {milestone.organization}
                      </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 shrink-0 pt-0.5 sm:pt-0">
                      <span class="font-mono text-xs text-zinc-300 px-2 py-0.5 bg-zinc-900 border border-white/10 whitespace-nowrap">
                        {milestone.period}
                      </span>
                      <span
                        class={`font-mono text-xs px-2 py-0.5 uppercase border whitespace-nowrap ${milestone.status === "Current" ? "text-emerald-400 border-emerald-500/30" : "text-zinc-400 border-white/10"}`}
                      >
                        {milestone.status}
                      </span>
                    </div>
                  </div>
                </div>

                <ul class="space-y-1.5 text-xs sm:text-sm text-zinc-400 font-sans leading-relaxed list-disc list-outside pl-4 sm:pl-5">
                  {milestone.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="scroll-anchor hidden sm:flex justify-center mt-auto pt-4 sm:pt-6 transition-opacity duration-300 opacity-0 pointer-events-none"
      >
        <a
          href="#projects"
          class="group inline-block select-none"
          aria-label="Scroll to Projects"
        >
          <BorderGlow
            client:visible
            edgeSensitivity={0}
            minProximityOnHover={0.75}
            borderRadius={0}
            glowRadius={10}
            glowIntensity={0.8}
            coneSpread={25}
            animated
            colors={["#FFFFFF", "#FFFFFF", "#FFFFFF"]}
            glowColor="0 0 100"
            backgroundColor="#000000"
            fillOpacity={0.15}
            className="w-fit inline-flex items-center px-3 py-1 cursor-pointer"
            timeout={4000}
          >
            <span
              class="font-mono text-[10px] text-zinc-400 group-hover:text-white transition-colors uppercase tracking-widest flex items-center gap-1.5"
            >
              <span>Featured Projects ↓</span>
            </span>
          </BorderGlow>
        </a>
      </div>
    </section>

    <section
      id="projects"
      class="min-h-[100dvh] w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-12 sm:py-16 scroll-mt-5 lg:scroll-mt-0 relative snap-start"
      aria-label="Projects"
    >
      <div class="max-w-4xl w-full mx-auto my-auto space-y-6 sm:space-y-8">
        <div class="text-center space-y-2">
          <h2
            class="pt-6 font-display font-bold text-2xl sm:text-3xl text-white tracking-tight"
          >
            Featured Projects.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {
            flagshipProjects.map((project) => (
              <a
                href={project.href}
                class="flex flex-col justify-between border border-white/10 bg-zinc-950/80 p-5 hover:border-white/30 transition-colors group rounded-none text-left"
              >
                <div class="space-y-2.5">
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-xs text-zinc-500 font-bold">
                      [{project.id}]
                    </span>
                  </div>
                  <h3 class="font-display font-bold text-base text-white group-hover:text-zinc-200 transition-colors">
                    {project.title}
                  </h3>
                  <p class="text-xs text-zinc-400 font-sans leading-relaxed">
                    {project.summary}
                  </p>
                </div>
                <div class="pt-4 border-t border-white/10 mt-4 flex flex-row-reverse font-mono text-[10px] text-zinc-500">
                  <span class="text-zinc-400 group-hover:text-white group-hover:translate-x-0.5 transition-all">
                    Read spec →
                  </span>
                </div>
              </a>
            ))
          }
        </div>

        <div
          class="border border-dashed border-white/15 bg-zinc-950/40 p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left"
        >
          <div class="space-y-0.5">
            <h3 class="font-display font-bold text-sm text-white">
              Explore all projects in the catalog
            </h3>
            <p class="text-xs text-zinc-400 font-sans">Look at it.</p>
          </div>
          <a
            href="/projects"
            class="inline-flex items-center justify-center font-display text-xs font-semibold uppercase tracking-wider h-8 px-4 bg-white text-black hover:bg-zinc-200 transition-all rounded-none shrink-0"
          >
            View all projects
          </a>
        </div>
      </div>

      <div
        class="scroll-anchor hidden sm:flex justify-center mt-auto pt-4 sm:pt-6 transition-opacity duration-300 opacity-0 pointer-events-none"
      >
        <a
          href="#skills"
          class="group inline-block select-none"
          aria-label="Scroll to Skills"
        >
          <BorderGlow
            client:visible
            edgeSensitivity={0}
            minProximityOnHover={0.75}
            borderRadius={0}
            glowRadius={10}
            glowIntensity={0.8}
            coneSpread={25}
            animated
            colors={["#FFFFFF", "#FFFFFF", "#FFFFFF"]}
            glowColor="0 0 100"
            backgroundColor="#000000"
            fillOpacity={0.15}
            className="w-fit inline-flex items-center px-3 py-1 cursor-pointer"
            timeout={4500}
          >
            <span
              class="font-mono text-[10px] text-zinc-400 group-hover:text-white transition-colors uppercase tracking-widest flex items-center gap-1.5"
            >
              <span>Cert & Tech Skills ↓</span>
            </span>
          </BorderGlow>
        </a>
      </div>
    </section>

    <section
      id="skills"
      class="min-h-[100dvh] w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-12 sm:py-16 scroll-mt-5 lg:scroll-mt-0 relative snap-start"
      aria-label="Credentials and skills"
    >
      <div class="max-w-4xl w-full mx-auto my-auto space-y-6 sm:space-y-7">
        <div class="text-center space-y-2">
          <h2
            class="font-display font-bold text-2xl sm:text-3xl text-white tracking-tight"
          >
            Certifications.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
          {
            certifications.map((cert) => (
              <div class="border border-white/10 bg-zinc-950/80 p-5 space-y-3 hover:border-white/25 transition-colors rounded-none">
                <div class="flex items-start justify-between gap-3">
                  <div class="space-y-1">
                    <h3 class="font-display font-bold text-base text-white tracking-tight">
                      {cert.title}
                    </h3>
                    <div class="text-xs text-zinc-400 font-sans">
                      Issued by {cert.issuer} • {cert.year}
                    </div>
                  </div>
                  <div class="w-8 h-8 border border-white/15 bg-zinc-900 flex items-center justify-center p-1 shrink-0">
                    {cert.id === "aws" && <AwsLogo class="w-full h-full" />}
                    {cert.id === "pearson" && (
                      <PearsonLogo class="w-full h-full" />
                    )}
                  </div>
                </div>

                <div class="space-y-1.5 border-t border-white/10 pt-2.5">
                  <span class="font-mono text-[11px] text-zinc-500 uppercase">
                    Competencies:
                  </span>
                  <ul class="space-y-1 text-xs text-zinc-300 font-sans list-disc list-outside pl-4">
                    {cert.pillars.map((pillar) => (
                      <li>{pillar}</li>
                    ))}
                  </ul>
                </div>

                <div class="pt-1">
                  <a
                    href={cert.badgeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-300 hover:text-white underline underline-offset-4"
                  >
                    Verify badge on Credly
                    <svg
                      class="size-3"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            ))
          }
        </div>

        <div class="text-center space-y-2">
          <h2
            class="font-display font-bold text-2xl sm:text-3xl text-white tracking-tight"
          >
            Technical Skills.
          </h2>
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-left"
        >
          {
            skillDomains.map((domain) => (
              <div class="border border-white/10 bg-zinc-950/80 p-3.5 space-y-2">
                <h3 class="font-display font-bold text-xs text-white border-b border-white/10 pb-1.5 uppercase tracking-wide">
                  {domain.domain}
                </h3>
                <ul class="space-y-1 font-mono text-[11px] text-zinc-400">
                  {domain.skills.map((skill) => (
                    <li class="flex items-center gap-1.5 text-zinc-300">
                      <span class="w-1.5 h-1.5 bg-white/70 rounded-none shrink-0" />
                      <span>{skill}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="scroll-anchor hidden sm:flex justify-center mt-auto pt-4 sm:pt-6 transition-opacity duration-300 opacity-0 pointer-events-none"
      >
        <a
          href="#gallery"
          class="group inline-block select-none"
          aria-label="Scroll to Community and Life Gallery"
        >
          <BorderGlow
            client:visible
            edgeSensitivity={0}
            minProximityOnHover={0.75}
            borderRadius={0}
            glowRadius={10}
            glowIntensity={0.8}
            coneSpread={25}
            animated
            colors={["#FFFFFF", "#FFFFFF", "#FFFFFF"]}
            glowColor="0 0 100"
            backgroundColor="#000000"
            fillOpacity={0.15}
            className="w-fit inline-flex items-center px-3 py-1 cursor-pointer"
            timeout={5000}
          >
            <span
              class="font-mono text-[10px] text-zinc-400 group-hover:text-white transition-colors uppercase tracking-widest flex items-center gap-1.5"
            >
              <span>Community & Life Gallery ↓</span>
            </span>
          </BorderGlow>
        </a>
      </div>
    </section>

    <section
      id="gallery"
      class="min-h-[100dvh] w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-12 sm:py-16 scroll-mt-5 lg:scroll-mt-0 relative snap-start"
      aria-label="Community, Events and Life Outside the Terminal"
    >
      <div class="max-w-5xl w-full mx-auto my-auto space-y-4 sm:space-y-6">
        <div class="text-center space-y-2">
          <h2
            class="font-display font-bold text-2xl sm:text-3xl text-white tracking-tight"
          >
            Community and Life.
          </h2>
          <p
            class="text-xs sm:text-sm text-zinc-400 font-sans max-w-lg mx-auto"
          >
            Workshops, competitions, food, and personal highlights.
          </p>
        </div>

        <div class="w-full flex justify-center">
          <ArchGallery client:visible />
        </div>
      </div>

      <div
        class="scroll-anchor hidden sm:flex justify-center mt-auto pt-4 sm:pt-6 transition-opacity duration-300 opacity-0 pointer-events-none"
      >
        <a
          href="#contact"
          class="group inline-block select-none"
          aria-label="Scroll to Recommendation and Contact"
        >
          <BorderGlow
            client:visible
            edgeSensitivity={0}
            minProximityOnHover={0.75}
            borderRadius={0}
            glowRadius={10}
            glowIntensity={0.8}
            coneSpread={25}
            animated
            colors={["#FFFFFF", "#FFFFFF", "#FFFFFF"]}
            glowColor="0 0 100"
            backgroundColor="#000000"
            fillOpacity={0.15}
            className="w-fit inline-flex items-center px-3 py-1 cursor-pointer"
            timeout={5000}
          >
            <span
              class="font-mono text-[10px] text-zinc-400 group-hover:text-white transition-colors uppercase tracking-widest flex items-center gap-1.5"
            >
              <span>Recommendation & Connect ↓</span>
            </span>
          </BorderGlow>
        </a>
      </div>
    </section>

    <section
      id="contact"
      class="min-h-[100dvh] w-full flex flex-col justify-center items-center px-4 sm:px-6 lg:px-8 py-12 sm:py-16 scroll-mt-5 lg:scroll-mt-0 relative snap-start"
      aria-label="Recommendation and Contact"
    >
      <div class="max-w-4xl w-full mx-auto my-auto space-y-6 sm:space-y-8">
        <div class="text-center space-y-2">
