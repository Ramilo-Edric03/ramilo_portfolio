---

<Layout
  title="Edric Russell Ramilo | Aspiring Cloud Engineer"
  description="Portfolio showcasing projects, hands-on experience, and ways to collaborate with Edric Russell Ramilo."
  image="/Avatar.jpg"
>
  <main class="container mx-auto max-w-5xl p-6 md:p-12 space-y-8">
    
    <nav class="flex justify-end border-b border-border pb-4">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-mono uppercase tracking-wider rounded-sm border border-border bg-card hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all hover-lift min-h-10"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
        </svg>
        Projects
      </a>
    </nav>

    <!-- Headers -->
    <section class="py-4 md:py-8 border-b border-white animate-fade-in">
      <div class="flex flex-row items-start gap-4 md:gap-12">
        <div class="relative shrink-0 animate-scale-in">
          <Image
            width="250"
            height="250"
            src="/Avatar.jpg"
            alt="Edric Russell Ramilo"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-32 h-32 sm:w-40 sm:h-40 md:w-44 md:h-44 rounded-sm object-cover border border-border"
          />
        </div>
        
        <!-- Header BOdy -->
        <div class="flex-1 space-y-3 sm:space-y-4 w-full">
          <div>
            <h1 class="text-xl sm:text-4xl md:text-6xl font-black tracking-tighter uppercase font-display leading-none">
              Edric Russell Ramilo
            </h1>
            <p class="text-[10px] sm:text-xs font-mono tracking-widest text-primary uppercase mt-1 sm:mt-2">
              [ Aspiring Cloud Engineer ]
            </p>
            <p class="text-xs sm:text-sm text-muted-foreground flex items-center gap-1.5 mt-2 sm:mt-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              Batangas, Philippines
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <a
              href="mailto:edric.ramilo191@gmail.com"
              aria-label="Send email"
              class="inline-flex items-center gap-2 px-3 py-2 text-[10px] font-mono uppercase tracking-wider rounded-sm border border-border bg-card hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all hover-lift"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
