  <script>
    const anchors = document.querySelectorAll(".scroll-anchor");
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const show = entry.isIntersecting;
            entry.target.classList.toggle("opacity-100", show);
            entry.target.classList.toggle("pointer-events-auto", show);
            entry.target.classList.toggle("opacity-0", !show);
            entry.target.classList.toggle("pointer-events-none", !show);
          });
        },
        { rootMargin: "-65% 0px 0px 0px" },
      );
      anchors.forEach((el) => observer.observe(el));
    } else {
      anchors.forEach((el) =>
        el.classList.remove("opacity-0", "pointer-events-none"),
      );
    }
  </script>
