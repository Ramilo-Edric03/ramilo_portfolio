---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  { id: "top", name: "Top", href: "/#top" },
  { id: "experience", name: "Experience", href: "/#experience" },
  { id: "projects", name: "Projects", href: "/#projects" },
  { id: "skills", name: "Skills", href: "/#skills" },
  { id: "gallery", name: "Gallery", href: "/#gallery" },
  { id: "contact", name: "Connect", href: "/#contact" },
  { id: "footer", name: "Footer", href: "/#footer" },
];
---

<aside
  class="hidden lg:flex fixed top-0 bottom-0 left-4 sm:left-6 w-35 xl:w-40 z-50 flex-col justify-between py-8 pointer-events-none select-none"
  aria-label="Sidebar Navigation"
>
  <div
    class="pointer-events-auto font-mono text-xs text-zinc-500 tracking-wider space-y-1.5 select-none"
  >
    <div class="flex items-center gap-1.5 text-zinc-400">
      <span class="text-zinc-300 font-bold tracking-widest text-xs"
        >EDRIC RUSSELL RAMILO</span
      >
    </div>
  </div>

  <nav
    class="my-auto py-6 space-y-1 font-mono text-xs uppercase tracking-wider pointer-events-auto"
    aria-label="Section navigation"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-nav-target={item.id}
          class="sidebar-nav-link flex items-center justify-between px-2.5 py-1.5 text-zinc-400 hover:text-white hover:bg-white/5 border-l-2 border-transparent transition-all group"
        >
          <span class="group-hover:translate-x-0.5 transition-transform">
            {item.name}
          </span>
        </a>
      ))
    }

    <div class="pt-3 border-t border-white/10 mt-3">
      <a
        href="/projects"
        class:list={[
          "flex items-center justify-between px-2.5 py-1.5 text-xs text-center transition-all border",
          currentPath === "/projects" || currentPath.startsWith("/projects/")
            ? "border-white/30 text-white bg-white/10 font-bold"
            : "border-transparent text-zinc-400 hover:text-white hover:border-white/10",
        ]}
      >
        <span> Project Catalog</span>
        <span class="text-[20px] text-zinc-500">→</span>
      </a>
    </div>
  </nav>

  <div class="space-y-4 pt-4 border-t border-white/10 pointer-events-auto">
    <div class="flex items-center justify-between text-zinc-400">
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/Ramilo-Edric03"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-white transition-colors"
          aria-label="GitHub Profile"
        >
          <svg
            class="size-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/edric-russell-ramilo/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-zinc-400 hover:text-white transition-colors"
          aria-label="LinkedIn Profile"
        >
          <svg
            class="size-4"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            ></path>
          </svg>
        </a>
        <a
          href="mailto:edric.ramilo191@gmail.com"
          class="text-zinc-400 hover:text-white transition-colors"
          aria-label="Send Email"
        >
          <svg
            class="size-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <a
      href="mailto:edric.ramilo191@gmail.com"
      class="w-full inline-flex items-center justify-center font-display text-xs font-semibold uppercase tracking-wider h-8 px-3 bg-white text-black hover:bg-zinc-200 transition-all border border-transparent rounded-none"
    >
      Get in Touch
    </a>
  </div>
</aside>

<header
  class="lg:hidden sticky top-0 z-40 w-full border-b border-white/10 bg-black/90 backdrop-blur-md h-12 flex items-center justify-between px-4 select-none"
>
  <a
    href="/"
    class="font-display font-bold text-xs uppercase tracking-wider text-white"
  >
    Edric Russell Ramilo
  </a>

  <button
    id="mobile-nav-toggle"
    type="button"
    class="font-mono text-[11px] uppercase tracking-wider text-zinc-400 hover:text-white border border-white/15 px-2.5 py-1 bg-zinc-950 flex items-center gap-1.5 focus:outline-none"
    aria-label="Toggle navigation drawer"
    aria-expanded="false"
  >
    <span id="mobile-nav-btn-text">MENU</span>
  </button>
</header>

<div
  id="mobile-nav-backdrop"
  class="lg:hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 transition-opacity duration-200 opacity-0 pointer-events-none"
  aria-hidden="true"
>
</div>

<div
  id="mobile-nav-drawer"
  class="lg:hidden fixed top-0 bottom-0 left-0 w-64 max-w-[80vw] bg-black p-5 flex flex-col justify-between z-50 transform -translate-x-full transition-transform duration-200 ease-in-out select-none"
  aria-label="Mobile Navigation Drawer"
>
  <nav
    class="my-auto py-4 space-y-1 font-mono text-xs uppercase tracking-wider"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-link flex items-center justify-between px-2.5 py-2 text-zinc-400 hover:text-white hover:bg-white/5 border-l-2 border-transparent transition-all underline"
        >
          <span>{item.name}</span>
          <span class="size-1 bg-transparent group-hover:bg-zinc-400" />
        </a>
      ))
    }

    <div class="pt-3 border-t border-white/10 mt-3">
      <a
        href="/projects"
        class:list={[
          "mobile-nav-link flex items-center justify-between px-2.5 py-2 text-xs border",
          currentPath === "/projects"
            ? "border-white/30 text-white bg-white/10 font-bold"
            : "border-transparent text-zinc-400 hover:text-white",
        ]}
      >
        <span>[ Project Catalog ]</span>
        <span class="text-zinc-500">→</span>
      </a>
    </div>
  </nav>

  <div class="space-y-4 pt-4 border-t border-white/10">
    <div class="flex items-center justify-between text-zinc-400">
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/Ramilo-Edric03"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors"
        >
          GitHub
        </a>
        <span class="text-zinc-700">/</span>
        <a
          href="https://www.linkedin.com/in/edric-russell-ramilo/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <a
      href="mailto:edric.ramilo191@gmail.com"
      class="w-full inline-flex items-center justify-center font-display text-xs font-semibold uppercase tracking-wider h-8 px-3 bg-white text-black hover:bg-zinc-200 transition-all border border-transparent rounded-none"
    >
      Get in Touch
    </a>
  </div>
</div>

<script>
  // Mobile drawer interaction
  const toggleBtn = document.getElementById("mobile-nav-toggle");
  const closeBtn = document.getElementById("mobile-nav-close");
  const backdrop = document.getElementById("mobile-nav-backdrop");
  const drawer = document.getElementById("mobile-nav-drawer");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function openDrawer() {
    if (!backdrop || !drawer || !toggleBtn) return;
    backdrop.classList.remove("opacity-0", "pointer-events-none");
    backdrop.classList.add("opacity-100", "pointer-events-auto");
    drawer.classList.remove("-translate-x-full");
    toggleBtn.setAttribute("aria-expanded", "true");
  }

  function closeDrawer() {
    if (!backdrop || !drawer || !toggleBtn) return;
    backdrop.classList.remove("opacity-100", "pointer-events-auto");
    backdrop.classList.add("opacity-0", "pointer-events-none");
    drawer.classList.add("-translate-x-full");
    toggleBtn.setAttribute("aria-expanded", "false");
  }

  toggleBtn?.addEventListener("click", () => {
    const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      closeDrawer();
    } else {
      openDrawer();
    }
  });

  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  mobileLinks.forEach((link) => link.addEventListener("click", closeDrawer));

  // Active section scroll spy for Desktop Sidebar
  const sectionIds = [
    "top",
    "experience",
    "projects",
    "skills",
    "gallery",
    "contact",
    "footer",
  ];
  const navLinks =
    document.querySelectorAll<HTMLAnchorElement>(".sidebar-nav-link");

  if ("IntersectionObserver" in window && window.location.pathname === "/") {
    const observerOptions = {
      root: null,
      rootMargin: "-25% 0px -50% 0px",
      threshold: 0,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const target = link.getAttribute("data-nav-target");
            const indicator = link.querySelector(".nav-indicator");
            if (target === id) {
              link.classList.add(
                "border-l-white",
                "text-white",
                "bg-white/5",
                "font-bold",
              );
              link.classList.remove("border-transparent", "text-zinc-400");
              if (indicator) {
                indicator.classList.add("bg-white");
                indicator.classList.remove("bg-transparent");
              }
            } else {
              link.classList.remove(
                "border-l-white",
                "text-white",
                "bg-white/5",
                "font-bold",
              );
              link.classList.add("border-transparent", "text-zinc-400");
              if (indicator) {
                indicator.classList.remove("bg-white");
                indicator.classList.add("bg-transparent");
              }
            }
          });
        }
      });
    }, observerOptions);

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
