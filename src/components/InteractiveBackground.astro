---
---

<div id="interactive-bg" class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
  <div class="grid-overlay"></div>
  <div class="glow-point"></div>
</div>

<script>
  const glow = document.querySelector('.glow-point') as HTMLElement;
  if (glow) {
    window.addEventListener('mousemove', (e) => {
      const x = e.clientX;
      const y = e.clientY;
      glow.style.transform = `translate3d(${x - 300}px, ${y - 300}px, 0)`;
    });
  }
</script>

<style>
  #interactive-bg {
    background: #000000;
  }

  .dark #interactive-bg {
    background: #000000;
  }

  .light #interactive-bg {
    background: #ffffff;
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(circle at 50% 50%, black 30%, rgba(0,0,0,0.3) 70%, transparent 100%);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 30%, rgba(0,0,0,0.3) 70%, transparent 100%);
  }

  .light .grid-overlay {
    background-image: 
      linear-gradient(to right, rgba(9, 9, 11, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(9, 9, 11, 0.025) 1px, transparent 1px);
  }

  /* Single subtle gradient glow that follows mouse - soft and elegant, not overwhelming */
  .glow-point {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(225, 29, 72, 0.04) 0%, transparent 70%);
    top: 0;
    left: 0;
    pointer-events: none;
    will-change: transform;
    transition: transform 0.1s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .light .glow-point {
    background: radial-gradient(circle, rgba(225, 29, 72, 0.03) 0%, transparent 70%);
  }
</style>
