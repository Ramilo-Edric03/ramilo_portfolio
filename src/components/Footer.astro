---
const year = new Date().getFullYear();
---

<footer class="w-full border-t border-white/10 bg-black py-12">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-10 border-b border-border/60"
    >
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <span
            class="font-display font-bold text-sm tracking-wider uppercase text-foreground"
          >
            Edric Russell Ramilo
          </span>
        </div>
        <p
          class="text-xs text-muted-foreground leading-relaxed max-w-xs font-sans"
        >
          Aspiring Cloud Engineer & Software Engineer
        </p>
        <div
          class="font-mono text-xs text-muted-foreground flex items-center gap-1.5"
        >
          <svg
            class="size-3.5 text-muted-foreground"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
            ></path>
          </svg>
          Philippines
        </div>
      </div>

      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-wider text-foreground">
          Navigation
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a
              href="/#experience"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              Experience Milestones
            </a>
          </li>
          <li>
            <a
              href="/#projects"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              Featured Systems
            </a>
          </li>
          <li>
            <a
              href="/projects"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              Full Project Catalog
            </a>
          </li>
          <li>
            <a
              href="/#skills"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              Verified Certifications & Skills
            </a>
          </li>
          <li>
            <a
              href="/#contact"
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              Direct Contact
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-3">
        <h4 class="font-mono text-xs uppercase tracking-wider text-foreground">
          Channels
        </h4>
        <div class="space-y-2 text-xs font-mono">
          <div>
            <a
              href="mailto:edric.ramilo191@gmail.com"
              class="text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5"
            >
              <svg
                class="size-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                ></path>
              </svg>
              edric.ramilo191@gmail.com
            </a>
          </div>
          <div>
            <a
              href="https://www.linkedin.com/in/edric-russell-ramilo/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5"
            >
              LinkedIn Profile →
            </a>
          </div>
          <div>
            <a
              href="https://github.com/Ramilo-Edric03"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5"
            >
              GitHub / Ramilo-Edric03 →
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-muted-foreground"
    >
      <div class="flex items-center gap-2">
        © {year} Edric Russell Ramilo.
      </div>
    </div>
  </div>
</footer>
